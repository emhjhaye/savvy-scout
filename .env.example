# Copy to .env and fill in. Never commit .env.

# SQLite database file path
SAVVY_SCOUT_DB_PATH=savvy_scout.db

# Sweep defaults
SAVVY_SCOUT_LOOKBACK_DAYS=7

# Find a Tender OCDS API (no auth required, public)
FIND_A_TENDER_BASE_URL=https://www.find-tender.service.gov.uk/api/1.0

# Contracts Finder API (no auth required, public)
CONTRACTS_FINDER_BASE_URL=https://www.contractsfinder.service.gov.uk/Published/Notices/OCDS/Search

# Phase B: AI scope reads (B2). Required for the "approve" action on the
# dashboard to run; the sweep/triage/export CLI commands work without it.
# Which provider is actually used is picked by SCOPE_READ_PROVIDER below --
# only that provider's key needs to be set.
ANTHROPIC_API_KEY=

# Alternate Phase 2 scope-read provider (2026-07-30), e.g. if Anthropic
# credit runs out. Set SCOPE_READ_PROVIDER=openai and fill this in instead
# of ANTHROPIC_API_KEY -- same assessment, same schema, different API.
OPENAI_API_KEY=
SCOPE_READ_PROVIDER=anthropic

# Phase B: Flask session signing key (B1). Generate with, e.g.,
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Phase B/C: Microsoft Graph app registration (B3 escalation email, C2
# calendar, C3 Teams nudges). Not needed until you send an escalation email
# from the dashboard; the brief still generates as a .docx without these.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# The mailbox the escalation email is sent from (must be an @bidsavvy.io
# address with Mail.Send rights granted to the app registration above).
MS_GRAPH_SENDER_UPN=
